<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="category_hr_hospital" model="ir.module.category">
            <field name="name">Hospital</field>
            <field name="description">User access levels for the Hospital</field>
            <field name="sequence">1</field>
        </record>

        <record id="group_hr_hospital_patient" model="res.groups">
            <field name="name">Patient</field>
            <field name="category_id" ref="category_hr_hospital"/>
            <field name="comment">Users with patient rights can only view their own data.</field>
        </record>

        <record id="group_hr_hospital_intern" model="res.groups">
            <field name="name">Intern</field>
            <field name="category_id" ref="category_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_hospital_patient'))]"/>
            <field name="comment">Interns can view and edit their visits.</field>
        </record>

        <record id="group_hr_hospital_doctor" model="res.groups">
            <field name="name">Doctor</field>
            <field name="category_id" ref="category_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_hospital_intern'))]"/>
            <field name="comment">Doctors can view and edit their own visits and those of their interns.</field>
        </record>

        <record id="group_hr_hospital_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="category_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_hospital_doctor'))]"/>
            <field name="comment">Managers can view all visits.</field>
        </record>

        <record id="group_hr_hospital_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="category_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_hospital_manager'))]"/>
            <field name="users" eval="[Command.link(ref('base.user_root)), Command.link(ref('base.user.admin'))]"/>
            <field name="comment">Administrators have full access to all module data.</field>
        </record>
    </data>
</odoo>