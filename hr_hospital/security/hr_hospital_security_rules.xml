<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="0">

    <record id="hr_hospital_visit_rule_patient" model="ir.rule">
        <field name="name">Patient: only sees his own visits.</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="domain_force">[('patient_id.user_id', '=' user.id)]
        </field>
        <field name="groups" eval="[(4, ref('group_hr_hospital_patient'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_hospital_visit_rule_intern" model="ir.rule">
        <field name="name">Intern: can edit their visits.</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="domain_force">[('doctor_id.user_id', '=' user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hr_hospital_intern'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_hospital_visit_rule_doctor" model="ir.rule">
        <field name="name">Doctor: sees his/her visits and those of interns.
        </field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="domain_force">['|', ('doctor_id.user_id', '=' user.id),
            ('doctor_id.mentor_id.user.id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('group_hr_hospital_doctor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_hospital_visit_rule_manager" model="ir.rule">
        <field name="name">Manager: sees all visits.</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hr_hospital_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_hospital_visit_rule_admin" model="ir.rule">
        <field name="name">Administrator: full access</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hr_hospital_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
