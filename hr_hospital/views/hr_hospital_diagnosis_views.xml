<odoo>
    <record id="hr_hospital_diagnosis_tree" model="ir.ui.view">
        <field name="name">hr.hospital.diagnosis.tree ()</field>
        <field name="model">hr.hospital.diagnosis</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="visit_id"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_id"/>
            </tree>
        </field>
    </record>

    <record id="hr_hospital_diagnosis_form" model="ir.ui.view">
        <field name="name">hr.hospital.diagnosis.form ()</field>
        <field name="model">hr.hospital.diagnosis</field>
        <field name="arch" type="xml">
            <form>
                <header></header>
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="name"/>
                        <field name="visit_id"/>
                        <field name="patient_id"/>
                        <field name="disease_id"/>
                        <field name="appointment_treatment"/>
                    </group>
                    <group>
                        <field name="doctor_id"/>
                        <field name="is_intern" invisible="True"/>
                        <field name="is_approved" readonly="is_intern"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_diagnosis_pivot" model="ir.ui.view">
        <field name="name">hr.hospital.diagnosis.pivot (hr.hospital.diagnosis)</field>
        <field name="model">hr.hospital.diagnosis</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <pivot string="Pivot Diseases" sample="1" disable_linking="1" display_quantity="1">
                <field name="create_date" interval="year" type="col"/>
                <field name="create_date" interval="moth" type="col"/>
                <field name="disease_type" type="row"/>
                <field name="disease_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="hr_hospital_diagnosis_graph" model="ir.ui.view">
        <field name="name">hr.hospital.diagnosis.graph (hr.hospital.diagnosis)</field>
        <field name="model">hr.hospital.diagnosis</field>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <graph string="Diseases statistic">
                <field name="disease_type" type="measure"/>
                <field name="create_date" interval="month"/>
            </graph>
        </field>
    </record>

    <record id="action_hr_hospital_diagnosis_window" model="ir.actions.act_window">
        <field name="name">Diagnosis</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.diagnosis</field>
        <field name="view_mode">tree,form,pivot,graph</field>
    </record>
</odoo>
